{
  "title": "QUANTEX Live Trading Dashboard",
  "uid": "quantex-live",
  "tags": ["quantex", "trading", "live"],
  "timezone": "browser",
  "refresh": "5s",
  "links": [
    {
      "title": "Adaptive Routing",
      "type": "dashboards",
      "targetBlank": false,
      "tags": ["adaptive", "routing"],
      "asDropdown": false,
      "icon": "external link"
    },
    {
      "title": "Dashboard: Adaptive Routing",
      "type": "link",
      "url": "/d/quantex-adaptive-routing/quantex-adaptive-routing",
      "targetBlank": false,
      "icon": "apps"
    }
  ],
  "panels": [
    {
      "title": "Account Balance",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"expr": "account_balance_usd", "legendFormat": "Balance"}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "red", "value": null},
            {"color": "green", "value": 10}
          ]}
        }
      }
    },
    {
      "title": "Equity Curve",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "account_balance_usd", "legendFormat": "Balance"},
        {"expr": "account_equity_usd", "legendFormat": "Equity"}
      ],
      "fieldConfig": {
        "defaults": {
          "lineWidth": 2,
          "fillOpacity": 10
        }
      }
    },
    {
      "title": "Drawdown",
      "type": "gauge",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [{"expr": "current_drawdown_pct", "legendFormat": "Drawdown"}],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 50,
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 10},
            {"color": "red", "value": 20}
          ]}
        }
      }
    },
    {
      "title": "Win Rate (Last 20)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [{"expr": "win_rate_rolling_20", "legendFormat": "Win Rate"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "red", "value": null},
            {"color": "yellow", "value": 0.4},
            {"color": "green", "value": 0.6}
          ]}
        }
      }
    },
    {
      "title": "Open Positions",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [{"expr": "open_positions_count", "legendFormat": "Open"}]
    },
    {
      "title": "Consecutive Losses",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "targets": [{"expr": "consecutive_losses_total", "legendFormat": "Losses"}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 2},
            {"color": "red", "value": 4}
          ]}
        }
      }
    },
    {
      "title": "Total PnL",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "targets": [{"expr": "total_pnl_usd", "legendFormat": "PnL"}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "red", "value": null},
            {"color": "green", "value": 0}
          ]}
        }
      }
    },
    {
      "title": "Trades per Hour",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 12},
      "targets": [{"expr": "rate(trades_total[1h])", "legendFormat": "Trades/h"}]
    },
    {
      "title": "Cumulative PnL",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 12},
      "targets": [{"expr": "total_pnl_usd", "legendFormat": "Cumulative PnL"}]
    },
    {
      "title": "Trade PnL Distribution",
      "type": "histogram",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 12},
      "targets": [{"expr": "trade_pnl_usd_bucket", "legendFormat": "PnL"}]
    },
    {
      "title": "Agent Inference Latency",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 18},
      "targets": [{"expr": "rate(agent_inference_ms_sum[5m]) / rate(agent_inference_ms_count[5m])", "legendFormat": "{{agent}}"}]
    },
    {
      "title": "ML Model Health",
      "type": "stat",
      "gridPos": {"h": 6, "w": 4, "x": 8, "y": 18},
      "targets": [{"expr": "ml_model_accuracy", "legendFormat": "Accuracy"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "red", "value": null},
            {"color": "yellow", "value": 0.5},
            {"color": "green", "value": 0.7}
          ]}
        }
      }
    },
    {
      "title": "ML Model Age",
      "type": "stat",
      "gridPos": {"h": 6, "w": 4, "x": 12, "y": 18},
      "targets": [{"expr": "ml_model_age_hours", "legendFormat": "Age (h)"}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 24},
            {"color": "red", "value": 72}
          ]}
        }
      }
    },
    {
      "title": "Swarm Consensus",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 4, "x": 16, "y": 18},
      "targets": [{"expr": "swarm_consensus_score", "legendFormat": "Consensus"}],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "red", "value": null},
            {"color": "yellow", "value": 0.4},
            {"color": "green", "value": 0.7}
          ]}
        }
      }
    },
    {
      "title": "Services Status",
      "type": "table",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 24},
      "targets": [{"expr": "up", "legendFormat": "{{job}}"}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "red", "value": null},
            {"color": "green", "value": 1}
          ]}
        }
      }
    },
    {
      "title": "Active Alerts",
      "type": "table",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 24},
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "{{alertname}}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "alertstate": true,
              "Value": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "agent": 2,
              "provider": 3
            },
            "renameByName": {
              "alertname": "Alert",
              "agent": "Agent",
              "provider": "Provider"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "blue", "value": 0},
              {"color": "yellow", "value": 0.5},
              {"color": "red", "value": 0.9}
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "critical": {"color": "red", "text": "CRITICAL"},
                "warning": {"color": "yellow", "text": "WARNING"},
                "info": {"color": "blue", "text": "INFO"}
              }
            }
          ]
        }
      },
      "description": "Currently firing Prometheus alerts across all rule groups"
    },
    {
      "title": "Pipeline Path Ratio",
      "type": "piechart",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 30},
      "targets": [
        {
          "expr": "sum by (path) (pipeline_path_total)",
          "legendFormat": "{{path}}",
          "instant": true
        }
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "values": ["percent", "value"]},
        "pieType": "donut"
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "fast"},
            "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "heavy"},
            "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]
          }
        ]
      },
      "description": "Fast path (scalping) vs Heavy path (VLM+RAG+swarm) ratio"
    },
    {
      "title": "Fast Path Ratio",
      "type": "stat",
      "gridPos": {"h": 3, "w": 4, "x": 0, "y": 36},
      "targets": [
        {
          "expr": "pipeline_fast_path_ratio * 100",
          "legendFormat": "Ratio",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "orange", "value": null},
            {"color": "green", "value": 50},
            {"color": "blue", "value": 80}
          ]}
        }
      },
      "description": "Percentage of pipeline runs taking the scalping fast path"
    },
    {
      "title": "Pipeline Latency by Path (precomputed)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 30},
      "targets": [
        {
          "expr": "pipeline_avg_latency_fast_5m",
          "legendFormat": "Fast Path (scalping)"
        },
        {
          "expr": "pipeline_avg_latency_heavy_5m",
          "legendFormat": "Heavy Path (VLM+RAG+swarm)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "lineWidth": 2,
          "fillOpacity": 10,
          "color": {"mode": "palette-classic"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Fast Path (scalping)"},
            "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Heavy Path (VLM+RAG+swarm)"},
            "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]
          }
        ]
      },
      "description": "Average pipeline latency per path (5m rolling average, precomputed)"
    },
    {
      "title": "Pipeline Throughput",
      "type": "stat",
      "gridPos": {"h": 3, "w": 4, "x": 12, "y": 36},
      "targets": [
        {
          "expr": "pipeline_throughput_1m",
          "legendFormat": "candles/min",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "red", "value": null},
            {"color": "green", "value": 1}
          ]}
        }
      },
      "description": "Total pipeline throughput (candles processed per minute)"
    },
    {
      "title": "Scalping Decisions",
      "type": "bargauge",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 30},
      "targets": [
        {
          "expr": "sum by (action) (scalping_decisions_total)",
          "legendFormat": "{{action}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "BUY"},
            "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "SELL"},
            "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "HOLD"},
            "properties": [{"id": "color", "value": {"fixedColor": "blue", "mode": "fixed"}}]
          }
        ]
      },
      "description": "Scalping engine decision distribution (BUY/SELL/HOLD)"
    }
  ]
}
