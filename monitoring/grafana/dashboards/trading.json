{
  "title": "QUANTEX Live Trading Dashboard",
  "uid": "quantex-live",
  "tags": ["quantex", "trading", "live"],
  "timezone": "browser",
  "refresh": "5s",
  "panels": [
    {
      "title": "Account Balance",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"expr": "account_balance_usd", "legendFormat": "Balance"}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "red", "value": null},
            {"color": "green", "value": 10}
          ]}
        }
      }
    },
    {
      "title": "Equity Curve",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "account_balance_usd", "legendFormat": "Balance"},
        {"expr": "account_equity_usd", "legendFormat": "Equity"}
      ],
      "fieldConfig": {
        "defaults": {
          "lineWidth": 2,
          "fillOpacity": 10
        }
      }
    },
    {
      "title": "Drawdown",
      "type": "gauge",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [{"expr": "current_drawdown_pct", "legendFormat": "Drawdown"}],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 50,
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 10},
            {"color": "red", "value": 20}
          ]}
        }
      }
    },
    {
      "title": "Win Rate (Last 20)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [{"expr": "win_rate_rolling_20", "legendFormat": "Win Rate"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "red", "value": null},
            {"color": "yellow", "value": 0.4},
            {"color": "green", "value": 0.6}
          ]}
        }
      }
    },
    {
      "title": "Open Positions",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [{"expr": "open_positions_count", "legendFormat": "Open"}]
    },
    {
      "title": "Consecutive Losses",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "targets": [{"expr": "consecutive_losses_total", "legendFormat": "Losses"}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 2},
            {"color": "red", "value": 4}
          ]}
        }
      }
    },
    {
      "title": "Total PnL",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "targets": [{"expr": "total_pnl_usd", "legendFormat": "PnL"}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "red", "value": null},
            {"color": "green", "value": 0}
          ]}
        }
      }
    },
    {
      "title": "Trades per Hour",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 12},
      "targets": [{"expr": "rate(trades_total[1h])", "legendFormat": "Trades/h"}]
    },
    {
      "title": "Cumulative PnL",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 12},
      "targets": [{"expr": "total_pnl_usd", "legendFormat": "Cumulative PnL"}]
    },
    {
      "title": "Trade PnL Distribution",
      "type": "histogram",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 12},
      "targets": [{"expr": "trade_pnl_usd_bucket", "legendFormat": "PnL"}]
    },
    {
      "title": "Agent Inference Latency",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 18},
      "targets": [{"expr": "rate(agent_inference_ms_sum[5m]) / rate(agent_inference_ms_count[5m])", "legendFormat": "{{agent}}"}]
    },
    {
      "title": "ML Model Health",
      "type": "stat",
      "gridPos": {"h": 6, "w": 4, "x": 8, "y": 18},
      "targets": [{"expr": "ml_model_accuracy", "legendFormat": "Accuracy"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "red", "value": null},
            {"color": "yellow", "value": 0.5},
            {"color": "green", "value": 0.7}
          ]}
        }
      }
    },
    {
      "title": "ML Model Age",
      "type": "stat",
      "gridPos": {"h": 6, "w": 4, "x": 12, "y": 18},
      "targets": [{"expr": "ml_model_age_hours", "legendFormat": "Age (h)"}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 24},
            {"color": "red", "value": 72}
          ]}
        }
      }
    },
    {
      "title": "Swarm Consensus",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 4, "x": 16, "y": 18},
      "targets": [{"expr": "swarm_consensus_score", "legendFormat": "Consensus"}],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "red", "value": null},
            {"color": "yellow", "value": 0.4},
            {"color": "green", "value": 0.7}
          ]}
        }
      }
    },
    {
      "title": "Services Status",
      "type": "table",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 24},
      "targets": [{"expr": "up", "legendFormat": "{{job}}"}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "red", "value": null},
            {"color": "green", "value": 1}
          ]}
        }
      }
    }
  ]
}
