# ═══════════════════════════════════════════════════════════════════════════
#  Trade Agent - Environment Configuration
#  Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════════════════

# -- NVIDIA NIM ------------------------------------------------------------
# Get your API key at https://build.nvidia.com
NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-70b-instruct
NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
NIM_TIMEOUT=30.0

# -- Market data -----------------------------------------------------------
# Primary exchange (legacy -- kept for backward compatibility).
EXCHANGE=binance
# Comma-separated list of exchanges in priority order (overrides EXCHANGE).
EXCHANGES=binance,bybit,hyperliquid
# Trading symbols (comma-separated or JSON array).
SYMBOLS=BTC/USDT,ETH/USDT
WS_RECONNECT_DELAY=2.0

# -- Infrastructure --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
PG_DSN=postgresql+asyncpg://trader:changeme@postgres:5432/tradingdb
TRITON_URL=triton:8001

# -- Sentinel-X integration (optional -- leave blank to use pure-Python) ---
SENTINELX_RISK_ADDR=http://localhost:8080
SENTINELX_GATEWAY_URL=http://localhost:8080
SENTINELX_TIMEOUT_S=8.0

# -- Risk limits -----------------------------------------------------------
MAX_DAILY_DRAWDOWN_PCT=0.05
KELLY_FRACTION=0.25
MAX_POSITION_PCT=0.10
VAR_CONFIDENCE=0.99
VAR_LOOKBACK_DAYS=252
ATR_STOP_MULTIPLIER=2.0

# -- Council consensus -----------------------------------------------------
MIN_CONSENSUS_SCORE=0.65
COUNCIL_TIMEOUT_S=30.0

# -- Execution -------------------------------------------------------------
PAPER_TRADING=true
INITIAL_CAPITAL=100000.0
MAX_SLIPPAGE_BPS=10
ORDER_TIMEOUT_S=5.0

# -- RL Execution agent ----------------------------------------------------
PPO_MODEL_PATH=/models/ppo_execution/latest.zip
PPO_RETRAIN_INTERVAL_HOURS=24

# -- MLOps -----------------------------------------------------------------
PSI_DRIFT_THRESHOLD=0.2
WFO_TRAIN_MONTHS=12
WFO_TEST_MONTHS=3

# -- Observability ----------------------------------------------------------
PROMETHEUS_PORT=8000
LOG_LEVEL=INFO

# -- Feature Extraction Engine ----------------------------------------------
FEATURES_ENABLED=true
FEATURE_TRADE_WINDOW_S=60
FEATURE_FUNDING_POLL_S=300
FEATURE_OI_POLL_S=60
FEATURE_CVD_LOOKBACK=20

# -- TurboVec Memory Engine -------------------------------------------------
TURBOVEC_INDEX_DIR=.turbovec
TURBOVEC_DIMENSION=768
TURBOVEC_MAX_RESULTS=8
TURBOVEC_COMPACT_INTERVAL_HOURS=1.0
MEMORY_ENABLED=true

# -- Backtesting -----------------------------------------------------------
# Run in backtest mode (--backtest CLI flag overrides this).
BACKTEST=false
# Default parameters for backtest runs.
BACKTEST_START=2024-01-01
BACKTEST_END=2024-12-31
BACKTEST_TIMEFRAME=1h
BACKTEST_SLIPPAGE_BPS=5.0
BACKTEST_MAX_CYCLES=0
