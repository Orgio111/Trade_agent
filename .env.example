# QUANTEX canonical local paper/replay runtime template.
# Generate the ignored env and two independent secret files with:
#   uv run python scripts/init_local_runtime.py
# Then run the redacting preflight against the generated env.
# Never add broker, cloud-provider, Telegram, or live credentials to this file.

POSTGRES_PASSWORD_FILE_PATH=.local/secrets/postgres_admin_password
DB_RUNTIME_PASSWORD_FILE_PATH=.local/secrets/db_runtime_password

POSTGRES_DB=quantex
POSTGRES_USER=quantex
POSTGRES_PORT=5432
REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222
CONTROL_PLANE_PORT=8001

RUNTIME_MODE=paper_live
PAPER_TRADING=true
PAPER_ACCOUNT_ID=paper-main
OLLAMA_BASE_URL=http://127.0.0.1:11434
CANDIDATE_PROVIDER=ollama
