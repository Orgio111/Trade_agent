# Telegram Bot Configuration (from @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# ── Binance Spot Testnet ──
BINANCE_API_KEY=YOUR_BINANCE_TESTNET_API_KEY
BINANCE_SECRET_KEY=YOUR_BINANCE_TESTNET_SECRET_KEY
BINANCE_TESTNET=true

# ── Symbol Configuration ──
TRADE_SYMBOLS=BTC/USDT

# ── NATS JetStream ──
NATS_URL=nats://localhost:4222
NATS_SUBJECT_RAW=signals.raw
NATS_SUBJECT_AGGREGATED=signals.aggregated
NATS_SUBJECT_EXECUTED=signals.executed

# ── AI Model Endpoints ──
NVIDIA_NIM_API_KEY=YOUR_NIM_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
OLLAMA_BASE_URL=http://localhost:11434

# Optional local OpenAI-compatible inference token; leave empty when unused.
# Do not place a cloud API credential here.
OPENAI_API_KEY=

# Local service credentials used by Docker Compose.
# Set DATABASE_URL to the full container DSN using the same URL-encoded password.
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_POSTGRES_PASSWORD
DATABASE_URL=CHANGE_ME_LOCAL_DATABASE_URL
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_LOCAL_GRAFANA_PASSWORD

# ── Risk Parameters ──
ACCOUNT_EQUITY_USDT=10000.0
RISK_PCT_PER_TRADE=0.015
DMS_TIMEOUT_SECS=3

# ── Paper Trading ──
PAPER_TRADING=true
