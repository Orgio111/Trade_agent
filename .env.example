# QUANTEX Environment Variables
# Copy to .env and fill in values

# API Keys
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Inference Budget Tier (free | low | medium)
INFERENCE_BUDGET_TIER=free

# Database
DATABASE_URL=postgresql://quantex:secret@postgres:5432/quantex
POSTGRES_DB=quantex
POSTGRES_USER=quantex
POSTGRES_PASSWORD=secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Trading
INITIAL_BALANCE=1000.0

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=quantex123

# Orchestrator
ORCHESTRATOR_PORT=8001

# Certbot / SSL
CERTBOT_DOMAIN=quantex.local
CERTBOT_EMAIL=admin@quantex.local
CERTBOT_RENEW_INTERVAL=43200
