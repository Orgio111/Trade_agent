# Rust
target/
Cargo.lock

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
*.so

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib

# Node / TypeScript
node_modules/
.next/
dist/
build/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*
!.env.example

# Secrets / TLS material (generated at build/runtime, never committed)
*.key
*.pem
deployment/nginx/ssl/*.crt
deployment/nginx/ssl/*.cnf

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data
data/
*.db
*.sqlite
*.sqlite3

# Local knowledge index (generated by ChromaDB; never commit runtime vectors)
.local/knowledge/
.chroma/
chroma-data/
.pytest_tmp*/

# Logs
logs/
*.log

# Models
models/
*.rl
*hmm_vs_adk_comprarison.json
training_history.json

# ── Second brain (wiki/) ──────────────────────────────────────────────
# Ignore Obsidian's per-user workspace state (machine-specific).
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Raw knowledge is committed (papers, articles, notes = the source of truth).
# But large datasets/backtest dumps that are *inputs* to study should not bloat the repo.
wiki/raw/data/*.parquet
wiki/raw/data/*.csv
wiki/raw/data/*.h5
